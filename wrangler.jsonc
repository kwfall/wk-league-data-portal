// Cloudflare 배포 설정: _site 폴더를 그대로 올리는 정적 사이트
// 주소: https://wk-league-data.kwfall.workers.dev/  (name 이 사이트 이름, kwfall 은 Cloudflare 계정의 workers.dev 이름)
{
  "name": "wk-league-data",
  "account_id": "9a6f0e2c70195ca71eed3f6a4228cc25",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "main": "worker.js",
  // 방문 기록(화면별 머문 시간, 시·도)을 쌓는 곳
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "wk_events" }],
  // /admin 만 worker.js 가 먼저 받아 비밀번호를 묻고, 나머지는 사이트 파일을 그대로 보낸다
  "assets": { "directory": "./_site", "binding": "ASSETS", "run_worker_first": ["/admin", "/admin/*", "/_admin.json", "/api/*"] }
}
